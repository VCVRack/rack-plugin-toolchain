CT_CONFIG_VERSION="4"
CT_ARCH_X86=y
CT_ARCH_64=y
CT_TARGET_VENDOR="ubuntu16.04"
CT_KERNEL_LINUX=y
# Compile against Linux kernel 4.4 headers
CT_LINUX_V_4_4=y
# Skip checking Linux headers for missing includes
CT_KERNEL_LINUX_INSTALL_CHECK=n
CT_GLIBC_V_2_23=y
CT_CC_LANG_CXX=y
CT_GCC_V_16=y
CT_BINUTILS_V_2_47=y
# Don't make files in the toolchain unwritable
CT_PREFIX_DIR_RO=n
