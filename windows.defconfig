CT_CONFIG_VERSION="4"
# Required for Crosstool-NG to build Windows toolchain on Linux
CT_EXPERIMENTAL=y
CT_ARCH_X86=y
# Disable building 32-bit runtime libraries
CT_MULTILIB=n
CT_ARCH_64=y
CT_TARGET_VENDOR="w64"
CT_KERNEL_WINDOWS=y
# Allow ld, ar, nm, ranlib, etc to load plugins such as GCC's link-time optimization plugin
CT_BINUTILS_PLUGINS=y
CT_MINGW_DIRECTX=n
# Install Windows kernel driver headers
CT_MINGW_DDK=y
# Use winpthreads
CT_THREADS_POSIX=y
CT_CC_LANG_CXX=y
CT_CC_LANG_FORTRAN=n
CT_GCC_V_16=y
CT_BINUTILS_V_2_47=y
CT_MINGW_W64_V_V14_0=y
# Use MSVCRT as the default C runtime
CT_MINGW_DEFAULT_MSVCRT_MSVCRT=y
# Don't make files in the toolchain unwritable
CT_PREFIX_DIR_RO=n
